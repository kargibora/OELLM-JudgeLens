{
  "name": "@prefscope/viewer",
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive response-concept explorer for PrefScope post-training and SAE analysis bundles.",
  "license": "MIT",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js"
    },
    "./style.css": "./lib/style.css"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "build:all": "npm run build && npm run build:lib",
    "test:bundle": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "preview": "vite preview",
    "prepack": "npm run build:lib"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "recharts": "^2.13.3"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^8.1.5"
  }
}
